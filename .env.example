# Copy to .env (git-ignored) and fill in. Never commit .env.
# Provider: gemini or openai
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional ElevenLabs key for server-side TTS/STT (falls back to browser Web Speech API when blank)
ELEVENLABS_API_KEY=
